integrator  = md
gen-vel     = yes
gen-temp    = 300
nsteps      = 20000
dt          = 0.002
nstxout     = 2000         
nstvout     = 0
nstenergy   = 100
nstlog      = 1000
constraints = none
nstlist     = 10
rlist       = 1.0
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype = cut-off
vdw_type	= cut-off
tcoupl              = V-rescale     ; correct canonical ensemble; Berendsen does not give the right kinetic energy distribution (deprecated 2025+)
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pbc     = xyz
nstcomm         = 10
comm-mode       = Angular
comm-grps       = System 
table-extension	= 1
