title       = NPT for bond relaxation
integrator  = md
gen-vel     = yes
gen-temp    = 300
nsteps      = 40000
dt          = 0.001
nstxout     = 50             
nstvout     = 0
nstenergy   = 10
nstlog      = 100
constraints = none
nstlist     = 30
rlist       = 0.9
rcoulomb    = 0.9
rvdw        = 0.9
coulombtype     = PME
vdw_type	= cut-off
fourierspacing  = 0.12
pme_order       = 4
ewald_rtol      = 1e-5
optimize_fft    = yes
tcoupl              = V-rescale     ; correct canonical ensemble; Berendsen does not give the right kinetic energy distribution (deprecated 2025+)
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pcoupl              = C-rescale     ; correct NPT ensemble and robust far from equilibrium; Berendsen is neither (deprecated 2025+)
pcoupltype          = isotropic     ; uniform scaling of x-y-z box vectors
tau_p               = 0.5           ; time constant, in ps
ref_p               = 1.0
compressibility     = 4.5e-5
pbc     = xyz
nstcomm         = 10
comm-mode       = Linear
comm-grps       = System 
table-extension	= 1
periodic-molecules = yes

