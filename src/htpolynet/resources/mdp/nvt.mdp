integrator  = md
nsteps      = 50000
dt          = 0.002
nstxout     = 500           
nstvout     = 0
nstenergy   = 500
nstlog      = 500
constraints = h-bonds       ; not all-bonds; see CHANGELOG 2.7.0
lincs_order = 8             ; GROMACS default 4 is marginal here
nstlist     = 10
rlist       = 1.0
rcoulomb    = 1.0
rvdw        = 1.0
coulombtype     = PME
vdw_type	= cut-off
fourierspacing  = 0.12
pme_order       = 4
ewald_rtol      = 1e-5
optimize_fft    = yes
tcoupl              = V-rescale     ; correct canonical ensemble; Berendsen does not give the right kinetic energy distribution (deprecated 2025+)
tc-grps     = System
tau_t       = 0.1
ref_t       = 300
pbc     = xyz
nstcomm         = 10
comm-mode       = Linear
comm-grps       = System 
table-extension	= 1
periodic-molecules = yes

